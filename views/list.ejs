<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <!-- <link href="https://cdn.bootcdn.net/ajax/libs/twitter-bootstrap/3.3.7/css/bootstrap.css" rel="stylesheet"/> -->
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <style>
        label {
            font-weight: normal;
        }
        .panel-body hover .glyphicon-remove{
            display: inline-block
        }
        .panel-heading {
            background-color:pink;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-lg-8 col-lg-offset-2">
                <div class="row">
                    <h2 class="col-xs-6">记账本</h2>
                    <div class="col-xs-6 text-right" style="margin-top:20px;">
                        <a href="/account/create" class="btn btn-primary" style="margin-right:40px;">添加账单</a>
                        <form method="post" action="/logout" style="display:inline;margin:0;">
                            <button class="btn btn-danger">退出登录</button>
                        </form>                   
                        <!-- <a href="/logout" class="btn btn-danger">退出登录</a> -->
                    </div>
                </div>
                <hr />      
            <div class="account">
                <% content.forEach((item) => { %>
                    <div class="panel <%= item.type==='支出' ? 'panel-danger' : 'panel-success' %>">
                        <div class="panel-heading"><%= moment(item.occurrence).format('YY-MM-DD') %></div>
                        <div class="panel-body">
                        <div class="row">
                            <div class="col-xs-6"><%= item.title %></div>
                            <div class="col-xs-2 text-center">
                            <span class="label <%= item.type===false ? 'label-warning' : 'label-success' %>"><%= item.type === false? '支出':'收入' %></span>
                            </div>
                            <div class="col-xs-2 text-right"><%= item.account %>元</div>
                            <div class="col-xs-2 text-right">
                                <a class="delBtn" href="/account/<%= item.id %>">
                                <span 
                                    class="glyphicon glyphicon-remove"
                                    aria-hidden="true"
                                ></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/bootstrap-datepicker.min.js"></script>
    <script src="/js/locales/bootstrap-datepicker.zh-CN.min.js"></script>
    
    <script src="/js/test.js"></script>
    
</body>
<script>
    console.log('btn')
    //获取所有的 delBtn
    let delBtns = document.querySelectorAll('.delBtn');
    console.log(delBtns)
    //绑定事件
    delBtns.forEach(item => {
        item.addEventListener('click', function(e){
            if(confirm('你确定要删除该文挡吗？')){
                return true;
            } else {
                //阻止默认行为
                e.preventDefault();
            }
        });
    })

</script>
</html>