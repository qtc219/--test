<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>添加记录</title>
    <link rel="stylesheet" href="/css/bootstrap.min.css">
    <link href="/css/bootstrap-datepicker.css" rel="stylesheet">
</head>
<body>
    <div class="container">
        <div class="row">
            <div class="col-xs-12 col-lg-8 col-lg-offset-2">
                <h2>添加记录</h2>
                <hr/>
                <form method="post" action="/account">
                    <div class="form-group">
                        <label for="item">事项</label>
                        <input 
                            type="text" 
                            id="item" 
                            name="title" 
                            class="form-control"
                        />
                    </div>
                    <div class="form-group">
                        <label for="occurrence">时间</label>
                        <input 
                        type="text" 
                        id="occurrence" 
                        name="occurrence" 
                        class="form-control"
                    />
                    </div>
                    <div class="form-group">
                        <label for="type">类型</label>
                        <select id="type" name="type" class="form-control">
                            <option value="">请选择</option>
                            <option value="收入">收入</option>
                            <option value="支出">支出</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="account">金额</label>
                        <input 
                            type="text" 
                            id="account" 
                            name="account" 
                            class="form-control"
                        />
                    </div>                          
                    <div class="form-group">
                        <label for="remark">备注</label>
                        <textarea type="text" id="remark" name="remark" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <button type="submit" class="btn btn-primary btn-block">添加记录</button>
                    </div>
                </form>
                
            </div>
        </div>
    </div>

    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/bootstrap-datepicker.min.js"></script>
    <script src="/js/locales/bootstrap-datepicker.zh-CN.min.js"></script>
    
    <script src="/js/test.js"></script>

</body>    
</html>